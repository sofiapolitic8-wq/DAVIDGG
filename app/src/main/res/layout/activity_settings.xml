<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">
        <Button android:id="@+id/btnHotkey" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=""/>
        <TextView android:id="@+id/lblBackend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/backend" android:textColor="@color/text" />
        <Spinner android:id="@+id/spBackend" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/lblLang" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/language" android:textColor="@color/text" />
        <Spinner android:id="@+id/spLang" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvGlobal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"  android:textColor="@color/text" />
        <SeekBar android:id="@+id/sbGlobal" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="290"/>
        <Switch android:id="@+id/swAuto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/auto_game_mode" android:textColor="@color/text"/>
        <Switch android:id="@+id/swBubble" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/bubble" android:textColor="@color/text"/>
        <Switch android:id="@+id/swHints" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/key_hints" android:textColor="@color/text"/>
        <Switch android:id="@+id/swCross" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/crosshair" android:textColor="@color/text"/>
        <TextView android:id="@+id/lblShape" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/crosshair_shape" android:textColor="@color/text" />
        <Spinner android:id="@+id/spShape" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/lblColor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/crosshair_color" android:textColor="@color/text" />
        <Spinner android:id="@+id/spColor" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"  android:textColor="@color/text" />
        <SeekBar android:id="@+id/sbSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="60"/>
        <TextView android:id="@+id/tvOffX" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"  android:textColor="@color/text" />
        <SeekBar android:id="@+id/sbOffX" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200"/>
        <TextView android:id="@+id/tvOffY" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"  android:textColor="@color/text" />
        <SeekBar android:id="@+id/sbOffY" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200"/>
    </LinearLayout>
</ScrollView>
